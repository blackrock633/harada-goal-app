  "narrative": {
    "northStar": "The Printed Harada Sheet",
    "overview": "A ruled paper form with ink entries. Structure comes from hairline rules, ink weight and type, not boxes. One vermilion marks what matters now. Mincho names, platform UI face for work.",
    "keyCharacteristics": [
      "Warm paper, warm ink, one vermilion; dark scheme keeps the hues.",
      "Flat: no shadows; depth is rules, sunken tone and a scrim.",
      "Square cells, 8-radius controls, 14-radius sheet only, pills for the focus toggle.",
      "Mincho for names, system face for work."
    ],
    "rules": [
      {
        "name": "The One Vermilion Rule",
        "body": "Vermilion marks what matters now (the one action, the selection, the done mark, focus).",
        "section": "colors"
      },
      {
        "name": "The Accent-On-Soft Rule",
        "body": "On vermilion-soft, text is vermilion-on-soft; plain vermilion text fails contrast there.",
        "section": "colors"
      },
      {
        "name": "The Mincho-For-Names Rule",
        "body": "Mincho is only for the goal and screen/section names.",
        "section": "typography"
      },
      {
        "name": "The Rules-Not-Boxes Rule",
        "body": "Group with a hairline or whitespace, not bordered or filled cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read values from useTheme() / tokens.ts.",
      "Do give every control a MIN_TOUCH target and an accessible name.",
      "Do keep one primary button per view.",
      "Do separate groups with hairlines and 16 to 24 spacing.",
      "Do keep text at 12 or larger and check both schemes."
    ],
    "donts": [
      "Don't wrap content in cards, shadows or tinted panels to create structure.",
      "Don't set vermilion text on vermilion-soft.",
      "Don't use Mincho for rows, buttons or metadata.",
      "Don't round matrix cells or apply 14 or 999 radius to ordinary controls.",
      "Don't label any measure goal progress.",
      "Don't hand-draw glyph icons or bypass the icon vocabulary."
