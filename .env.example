# --- Database -------------------------------------------------------------
# Local dev:  pglite://.data/dev  (embedded Postgres on disk; migrations applied automatically)
# Tests:      memory://
# Production: Supabase pooler URL (transaction mode), e.g. postgres://postgres.<ref>:<password>@<host>:6543/postgres
DATABASE_URL=pglite://.data/dev

# --- Supabase (production / staging) ---------------------------------------
# Project URL and public key (Project Settings > API). The anon key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Newer name for the same key; if set it takes precedence over the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SERVER ONLY. Bypasses RLS; used solely to delete accounts. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local dev auth without Supabase ----------------------------------------
# Set AUTH_PROVIDER=dev to use the PGlite-backed dev gateway. Ignored/forbidden when NODE_ENV=production.
# Leave unset (or "supabase") to use Supabase Auth.
# AUTH_PROVIDER=dev
# Required with AUTH_PROVIDER=dev: random string, 16+ chars (signs the dev session cookie).
# DEV_AUTH_SECRET=change-me-to-a-long-random-string

# --- Billing: see docs/MONETIZATION.md -------------------------------------
# Edge Function secrets/settings (do not expose in frontend builds).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_ENVIRONMENT=SANDBOX
# ALLOW_LIVE_BILLING=false
# APP_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer <random 32+ character token>
# REVENUECAT_ENTITLEMENT=harada_pro
# REVENUECAT_PRODUCT_IDS=
# BILLING_RECONCILE_AUTHORIZATION=Bearer <different random 32+ character token>
# Native build public SDK keys and published legal/support pages:
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_BILLING_SUPPORT_URL=
